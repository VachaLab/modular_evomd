# This is an example of instruction file.
# The variables related to the simulations,
# analysis, and penalties are defined
# here, as well as variables related to
# the evolution such as parent sequences
# number of iterations per sequence
# and population size.
# Variables related to the process control
# and actions are given through the command-line.

# Instructions:
# Comments are defined with #
# instructions are given always with =
# Lists are given between {}
# for example, sequences:

sequences = { # you can also include comments here
    QKLDS#sequences are limited by space or newline
    HAGVLKSHHMHHNTCSCSAKVM
    DEYTTKIVLCTQTVGPFLSNIH
    DEYTTKIVLCTQTVGPFLSNIH
    ## Add more sequences
  #  GKRFF this sequence won't be part of the list
    LNLDD      LNLDR #Here we have two different sequences
    DKDNR
FRSCTGLYHLWEEYVGSYSEDM
    FVLKR
} # The list ends here. Don't start a new instruction here.

# If no # is found the reader tries to read an 
# instruction, but = is needed.
What happend here?
# the last line will give a Warning like the next:
# WARNING: line "What happend here?" does not contain any instruction --> skipping

# if an instruction is not part of the Instructor class' 
# attributes, it is skipped.
This_is_not= 5.
# WARNING: "This_is_not" is not a valid instruction --> skipping

# Instructions must be defined with the same type
# as in Instructor class. Otherwise the default value
# is taken.
# ex. float instead of int
iterations = 5.
# WARNING: "iterations" is "float" but must be "int" --> using default value (3)

penalty = cambio
excluded_sequences={FRSCTGLYHLWEEYVGSYSEDM}
prohibited_patterns={KKKKKKKK}
check_validity = True
